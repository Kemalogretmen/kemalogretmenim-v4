{
  "name": "kemal-ogretmenim-mobile",
  "version": "0.6.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "npm run bridge:check && npm run whiteboard:check && npm run agenda:check && node --test tests/*.test.cjs",
    "bridge:generate": "node scripts/build-bridge.cjs",
    "bridge:check": "node scripts/build-bridge.cjs --check",
    "eas-build-post-install": "npm run bridge:check && npm run whiteboard:check && npm run agenda:check",
    "preview": "node scripts/preview-server.cjs",
    "build:web": "npm run bridge:check && npm run whiteboard:check && npm run agenda:check && expo export --platform web --output-dir dist",
    "whiteboard:generate": "node scripts/build-whiteboard.cjs",
    "whiteboard:check": "node scripts/build-whiteboard.cjs --check",
    "agenda:generate": "node scripts/build-agenda.cjs",
    "agenda:check": "node scripts/build-agenda.cjs --check"
  },
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@expo/vector-icons": "^15.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~58.0.22",
    "expo-auth-session": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.29",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "linkedom": "^0.18.14",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
