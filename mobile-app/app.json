{
  "expo": {
    "name": "Kemal Öğretmenim",
    "slug": "kemal-ogretmenim",
    "version": "0.6.2",
    "scheme": "kemalogretmenim",
    "orientation": "default",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FC"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kemalogretmenim.app",
      "buildNumber": "8",
      "infoPlist": {
        "NSCameraUsageDescription": "Profil ve öğretmen doğrulama dosyaları için kamera kullanılabilir.",
        "NSPhotoLibraryUsageDescription": "Profil ve öğretmen doğrulama dosyaları için fotoğraf seçilebilir.",
        "UISupportsDocumentBrowser": true
      }
    },
    "android": {
      "package": "com.kemalogretmenim.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#F7F8FC"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      "expo-screen-orientation",
      "expo-sharing",
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "siteUrl": "https://kemalogretmenim.com.tr",
      "supabaseUrl": "https://mwxcvlyrkptxrwgkmqum.supabase.co",
      "supabaseAnonKey": "sb_publishable__nk391uzfRC4bg3HQFHjlA_tH5kzmDY",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e563b139-5c2e-4a94-af2b-418e8f03207d"
      }
    },
    "owner": "kemalogretmen",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Kemal Öğretmenim Uygulaması",
      "shortName": "Kemal Öğretmenim"
    }
  }
}
