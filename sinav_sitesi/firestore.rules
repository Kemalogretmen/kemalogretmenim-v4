rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasExamPermission(key) {
      return isAdmin()
        && (
          adminDoc().data.keys().hasAny(['permissions']) == false
          || adminDoc().data.isOwner == true
          || adminDoc().data.permissions.get(key, false) == true
        );
    }

    function examDoc(examId) {
      return get(/databases/$(database)/documents/exams/$(examId));
    }

    function resultDoc(resultId) {
      return get(/databases/$(database)/documents/results/$(resultId));
    }

    function examIsPublished(examId) {
      return exists(/databases/$(database)/documents/exams/$(examId))
        && examDoc(examId).data.published == true;
    }

    function validGrade(g) {
      return (g is int && g >= 1 && g <= 8)
        || (g is string && g.matches('^[1-8]$'));
    }

    function validOptCount(n) {
      return n is int && n >= 2 && n <= 6;
    }

    function validTitle(t, maxLen) {
      return t is string && t.size() >= 1 && t.size() <= maxLen;
    }

    function validSube(s) {
      return s is string && s.size() >= 1 && s.size() <= 20;
    }

    function validAnswer(a) {
      return a is string && a in ['A','B','C','D','E','F'];
    }

    function validCategoryWrite() {
      return request.resource.data.keys().hasOnly(['grade', 'categories', 'sectionCategories', 'lessonCatalog', 'updatedAt'])
        && validGrade(request.resource.data.grade)
        && request.resource.data.categories is list
        && request.resource.data.categories.size() >= 1
        && request.resource.data.categories.size() <= 20
        && request.resource.data.sectionCategories is list
        && request.resource.data.sectionCategories.size() <= 20
        && request.resource.data.lessonCatalog is list
        && request.resource.data.lessonCatalog.size() >= 1
        && request.resource.data.lessonCatalog.size() <= 30
        && request.resource.data.updatedAt == request.time;
    }

    function validExamCreate() {
      return validTitle(request.resource.data.title, 140)
        && validGrade(request.resource.data.grade)
        && validTitle(request.resource.data.subject, 60)
        && request.resource.data.duration is int
        && request.resource.data.duration >= 0
        && request.resource.data.duration <= 240
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount >= 1
        && request.resource.data.questionCount <= 500
        && validOptCount(request.resource.data.optionCount)
        && request.resource.data.negativeMarking is bool
        && (request.resource.data.keys().hasAny(['hidden']) == false || request.resource.data.hidden is bool)
        && request.resource.data.published is bool
        && request.resource.data.createdAt == request.time;
    }

    function validExamUpdate() {
      return validTitle(request.resource.data.title, 140)
        && validGrade(request.resource.data.grade)
        && validTitle(request.resource.data.subject, 60)
        && request.resource.data.duration is int
        && request.resource.data.duration >= 0
        && request.resource.data.duration <= 240
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount >= 1
        && request.resource.data.questionCount <= 500
        && validOptCount(request.resource.data.optionCount)
        && request.resource.data.negativeMarking is bool
        && (request.resource.data.keys().hasAny(['hidden']) == false || request.resource.data.hidden is bool)
        && request.resource.data.published is bool
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validExamOrderUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayOrder', 'updatedAt'])
        && request.resource.data.displayOrder is int
        && request.resource.data.displayOrder >= 1
        && request.resource.data.displayOrder <= 5000
        && request.resource.data.updatedAt == request.time;
    }

    function validExamStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'published', 'updatedAt'])
        && request.resource.data.status is string
        && request.resource.data.status in ['active', 'paused', 'draft']
        && request.resource.data.published is bool
        && request.resource.data.published == (request.resource.data.status == 'active')
        && request.resource.data.updatedAt == request.time;
    }

    function validExamVisibilityUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'updatedAt'])
        && request.resource.data.hidden is bool
        && request.resource.data.updatedAt == request.time;
    }

    function validQuestionWrite() {
      return request.resource.data.examId is string
        && request.resource.data.examId.size() >= 1
        && exists(/databases/$(database)/documents/exams/$(request.resource.data.examId))
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.order <= 5000
        && validAnswer(request.resource.data.correctAnswer)
        && (
          (request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() >= 1
            && request.resource.data.imageUrl.size() <= 2048)
          || (request.resource.data.imageData is string
            && request.resource.data.imageData.size() >= 1
            && request.resource.data.imageData.size() <= 1030000)
        );
    }

    function resultKeysOk() {
      return request.resource.data.keys().hasOnly([
        'firstName','lastName','grade','sube',
        'accountUid','email',
        'subject','examTitle','examId',
        'correct','wrong','blank','netCorrect','score','score100','examScore','scoreScale','total',
        'negativeMarking','elapsed','date','answerDetails',
        'studentKey','clientAttemptId','questionSections'
      ]);
    }

    function validResultCreate() {
      return resultKeysOk()
        && validTitle(request.resource.data.firstName, 40)
        && validTitle(request.resource.data.lastName, 40)
        && validGrade(request.resource.data.grade)
        && validSube(request.resource.data.sube)
        && (
          request.resource.data.keys().hasAny(['accountUid']) == false
          || (
            request.resource.data.accountUid is string
            && request.resource.data.accountUid.size() <= 128
          )
        )
        && (
          request.resource.data.keys().hasAny(['email']) == false
          || (
            request.resource.data.email is string
            && request.resource.data.email.size() <= 160
          )
        )
        && validTitle(request.resource.data.subject, 60)
        && validTitle(request.resource.data.examTitle, 140)
        && request.resource.data.examId is string
        && request.resource.data.examId.size() >= 1
        && examIsPublished(request.resource.data.examId)
        && request.resource.data.correct is int
        && request.resource.data.wrong is int
        && request.resource.data.blank is int
        && request.resource.data.total is int
        && request.resource.data.correct >= 0
        && request.resource.data.wrong >= 0
        && request.resource.data.blank >= 0
        && request.resource.data.total > 0
        && request.resource.data.total <= 500
        && (request.resource.data.correct + request.resource.data.wrong + request.resource.data.blank) == request.resource.data.total
        && request.resource.data.negativeMarking is bool
        && request.resource.data.netCorrect is number
        && request.resource.data.netCorrect >= 0
        && request.resource.data.netCorrect <= request.resource.data.total
        && (
          request.resource.data.negativeMarking == true
          || request.resource.data.netCorrect <= request.resource.data.correct
        )
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && (
          request.resource.data.keys().hasAny(['score100']) == false
          || (
            request.resource.data.score100 is number
            && request.resource.data.score100 >= 0
            && request.resource.data.score100 <= 100
          )
        )
        && (
          request.resource.data.keys().hasAny(['examScore']) == false
          || (
            request.resource.data.examScore is number
            && request.resource.data.examScore >= 0
          )
        )
        && (
          request.resource.data.keys().hasAny(['scoreScale']) == false
          || (
            request.resource.data.scoreScale is int
            && request.resource.data.scoreScale >= 1
            && request.resource.data.scoreScale <= 5000
          )
        )
        && (
          request.resource.data.keys().hasAny(['examScore', 'scoreScale']) == false
          || request.resource.data.examScore <= request.resource.data.scoreScale
        )
        && request.resource.data.elapsed is int
        && request.resource.data.elapsed >= 0
        && request.resource.data.elapsed <= 14400
        && (
          request.resource.data.keys().hasAny(['answerDetails']) == false
          || (
            request.resource.data.answerDetails is list
            && request.resource.data.answerDetails.size() <= request.resource.data.total
          )
        )
        && (
          request.resource.data.keys().hasAny(['studentKey']) == false
          || (
            request.resource.data.studentKey is string
            && request.resource.data.studentKey.size() <= 160
          )
        )
        && (
          request.resource.data.keys().hasAny(['clientAttemptId']) == false
          || (
            request.resource.data.clientAttemptId is string
            && request.resource.data.clientAttemptId.size() <= 160
          )
        )
        && (
          request.resource.data.keys().hasAny(['questionSections']) == false
          || request.resource.data.questionSections is list
        )
        && request.resource.data.date == request.time;
    }

    function validAppealCreate() {
      return request.resource.data.keys().hasOnly([
        'resultId','examId','examTitle','subject','grade','sube',
        'firstName','lastName','studentKey',
        'questionNos','status','createdAt'
      ])
        && request.resource.data.resultId is string
        && request.resource.data.resultId.size() >= 1
        && exists(/databases/$(database)/documents/results/$(request.resource.data.resultId))
        && request.resource.data.examId is string
        && request.resource.data.examId == resultDoc(request.resource.data.resultId).data.examId
        && examIsPublished(request.resource.data.examId)
        && validTitle(request.resource.data.examTitle, 140)
        && validTitle(request.resource.data.subject, 60)
        && validGrade(request.resource.data.grade)
        && validSube(request.resource.data.sube)
        && validTitle(request.resource.data.firstName, 40)
        && validTitle(request.resource.data.lastName, 40)
        && request.resource.data.studentKey is string
        && request.resource.data.studentKey.size() <= 160
        && request.resource.data.questionNos is list
        && request.resource.data.questionNos.size() >= 1
        && request.resource.data.questionNos.size() <= 60
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /examCategories/{categoryId} {
      allow read: if true;
      allow create: if hasExamPermission('exam_category_create') && validCategoryWrite();
      allow update: if hasExamPermission('exam_category_edit') && validCategoryWrite();
      allow delete: if hasExamPermission('exam_category_delete');
    }

    match /exams/{examId} {
      allow read: if hasExamPermission('exam_list') || resource.data.published == true;
      allow create: if hasExamPermission('exam_create') && validExamCreate();
      allow update: if hasExamPermission('exam_edit') && (validExamUpdate() || validExamOrderUpdate() || validExamStatusUpdate() || validExamVisibilityUpdate());
      allow delete: if hasExamPermission('exam_delete');
    }

    match /questions/{questionId} {
      allow read: if hasExamPermission('exam_list') || hasExamPermission('exam_results') || hasExamPermission('exam_appeals') || examIsPublished(resource.data.examId);
      allow create: if hasExamPermission('exam_create') && validQuestionWrite();
      allow update: if (hasExamPermission('exam_edit') || hasExamPermission('exam_appeals')) && validQuestionWrite();
      allow delete: if hasExamPermission('exam_delete') || hasExamPermission('exam_edit');
    }

    match /results/{resultId} {
      allow create: if validResultCreate();
      allow read: if hasExamPermission('exam_results') || hasExamPermission('exam_results_edit') || hasExamPermission('exam_results_delete') || hasExamPermission('exam_single_report') || hasExamPermission('exam_report_center') || hasExamPermission('exam_appeals');
      allow update: if hasExamPermission('exam_results_edit') || hasExamPermission('exam_appeals');
      allow delete: if hasExamPermission('exam_results_delete');
    }

    match /resultAppeals/{appealId} {
      allow create: if validAppealCreate();
      allow read, update, delete: if hasExamPermission('exam_appeals');
    }
  }
}
